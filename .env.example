# Local platform services
POSTGRES_DB=ai_coding_server
POSTGRES_USER=ai_coding_server
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://ai_coding_server:change-me-for-local-development@postgres:5432/ai_coding_server
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=task-artifacts

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-unique-32-character-development-secret

# Deliberately unset: live model credentials never belong in a committed file.
# MODEL_PROVIDER_API_KEY=
